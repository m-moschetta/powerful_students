# Define the minimum iOS version supported by the Flutter app.
platform :ios, '18.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 18.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
      end

      # Disable bitcode (deprecated in Xcode 14+)
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Fix for iOS 26 beta module issues
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'

      # Remove Firebase Interop frameworks from linker flags (header-only pods)
      if config.build_settings['OTHER_LDFLAGS']
        config.build_settings['OTHER_LDFLAGS'].delete('-framework "FirebaseAppCheckInterop"')
        config.build_settings['OTHER_LDFLAGS'].delete('-framework "FirebaseAuthInterop"')
        config.build_settings['OTHER_LDFLAGS'].delete('-framework "RecaptchaInterop"')
      end
    end
  end

  # Also fix the generated xcconfig files
  Dir.glob(File.join('Pods', 'Target Support Files', 'Pods-Runner', '*.xcconfig')).each do |file|
    contents = File.read(file)

    # Remove Interop frameworks from OTHER_LDFLAGS
    contents.gsub!('-framework "FirebaseAppCheckInterop" ', '')
    contents.gsub!('-framework "FirebaseAuthInterop" ', '')
    contents.gsub!('-framework "RecaptchaInterop" ', '')

    # Remove Interop frameworks from FRAMEWORK_SEARCH_PATHS
    contents.gsub!('"${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAppCheckInterop" ', '')
    contents.gsub!('"${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuthInterop" ', '')
    contents.gsub!('"${PODS_CONFIGURATION_BUILD_DIR}/RecaptchaInterop" ', '')

    # Remove Interop frameworks from HEADER_SEARCH_PATHS
    contents.gsub!('"${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAppCheckInterop/FirebaseAppCheckInterop.framework/Headers" ', '')
    contents.gsub!('"${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuthInterop/FirebaseAuthInterop.framework/Headers" ', '')
    contents.gsub!('"${PODS_CONFIGURATION_BUILD_DIR}/RecaptchaInterop/RecaptchaInterop.framework/Headers" ', '')

    File.write(file, contents)
  end
end
